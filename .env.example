# Read by `make live`. Real environment variables take precedence.
CELERIS_WS_URL=
CELERIS_CLIENT_ID=
CELERIS_SIGNING_SECRET=
# CELERIS_WS_URL_PEER= (optional: a server node other than the one at CELERIS_WS_URL, such as ws://localhost:9003 when CELERIS_WS_URL is ws://localhost:9001; cross-node tests use it for the second connection and skip without it. A load-balancing gateway can route both connections to one node.)
